PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional in development/test; REQUIRED (non-empty) when NODE_ENV=production.
# The production-like stack (docker-compose.prod.yml) also uses this to set
# Redis `--requirepass`. The app fails fast at boot if it is missing in production.
REDIS_PASSWORD=

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1h
# Issuer (iss) and audience (aud) claims bound into and enforced on every token.
# Safe defaults are used when unset (govflow / govflow-api).
JWT_ISSUER=govflow
JWT_AUDIENCE=govflow-api

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Number of trusted reverse proxies in front of the API (Express "trust proxy").
# Must reflect EXACTLY how many trusted proxies sit in front of the app:
#   0 -> API is exposed directly (default, e.g. docker-compose.prod.yml on :3000)
#   1 -> exactly one trusted reverse proxy (e.g. nginx/ALB) in front of the API
# Never set this to "true": trusting all proxies lets clients spoof
# X-Forwarded-For and bypass per-IP rate limiting. Non-integer/negative/"true"
# values fall back to 0.
TRUST_PROXY_HOPS=0

# Rate limiting. Each limiter is per IP; windows are in milliseconds.
# Login (brute-force protection)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Mutating writes (POST /users, POST .../executions)
MUTATING_RATE_LIMIT_WINDOW_MS=900000
MUTATING_RATE_LIMIT_MAX=50
# Workflow processing (process / enqueue)
PROCESSING_RATE_LIMIT_WINDOW_MS=900000
PROCESSING_RATE_LIMIT_MAX=60
# Jira connectivity check (outbound call)
JIRA_RATE_LIMIT_WINDOW_MS=900000
JIRA_RATE_LIMIT_MAX=30
# Administrative operations (stale execution recovery)
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=20

# Stale workflow execution recovery
WORKFLOW_EXECUTION_RUNNING_TIMEOUT_MINUTES=30

# Jira integration
JIRA_ENABLED=false
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_TIMEOUT_MS=10000
